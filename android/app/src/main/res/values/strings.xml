    <!-- Floating button and voice input -->
    <string name="button_service_name">Dictate button</string>
    <string name="button_service_description">Shows a microphone button above the keyboard when a text field has focus. Tap it, talk, tap again: Dictate transcribes on this phone and puts the text into the field. To do that it needs to see which field has focus and where the keyboard is. With WhatsApp voice messages on, it also reads the name of an open WhatsApp chat to show that chat\'s voice messages as text above it. Nothing else is read, kept or sent.</string>
    <string name="button_copied">Copied: paste it where you want it</string>
